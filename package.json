		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/sveltekit": "^10.6.0",
		"@sveltejs/adapter-static": "4.0.0-next.4",
		"@sveltejs/kit": "3.0.0-next.30",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
