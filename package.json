	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@tanstack/ai": "0.63.0",
		"@tanstack/ai-anthropic": "0.19.3",
		"@tanstack/ai-svelte": "0.24.3",
